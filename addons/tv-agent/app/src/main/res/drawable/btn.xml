<?xml version="1.0" encoding="utf-8"?>
<!-- A remote-friendly button: unmistakable focus ring, since a TV is driven with a D-pad. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF7C5CFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF6A4BEB" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF161E27" />
            <stroke android:width="1dp" android:color="#FF2C3948" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
