<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#660A192F"
                        android:endColor="#E6020C1B" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <stroke
                        android:width="2.5dp"
                        android:color="#FF00B2E3" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#4D0F172A"
                        android:endColor="#CC020617" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#2EFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
