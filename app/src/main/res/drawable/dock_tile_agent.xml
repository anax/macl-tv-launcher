            <gradient android:angle="270" android:startColor="#FF8B5CF6" android:endColor="#FF5B21B6" />
            <stroke android:width="2.5dp" android:color="#FFC084FC" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
